<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PodManager</AssemblyName>
    <RootNamespace>PodManager.App</RootNamespace>
    <Product>PodManager</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF leaves System.IO out of the implicit usings (clash with System.Windows.Shapes.Path); nothing here uses Shapes. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PodManager.Core\PodManager.Core.csproj" />
  </ItemGroup>

</Project>

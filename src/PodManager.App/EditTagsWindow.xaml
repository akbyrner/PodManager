<Window x:Class="PodManager.App.EditTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get Info" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="#F2F4F7" UseLayoutRounding="True">
  <Grid x:Name="Root" Background="#F2F4F7">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border BorderBrush="#D5DAE0" BorderThickness="0,0,0,1" Padding="20,14">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#FBFCFD" Offset="0" />
          <GradientStop Color="#E9EDF2" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
      <StackPanel>
        <TextBlock x:Name="HeaderTitle" FontSize="17" FontWeight="SemiBold" Foreground="#22272E" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="HeaderSub" Foreground="#6B7280" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" Margin="20,16,20,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="180" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <Grid Width="164" Height="164" HorizontalAlignment="Left">
          <Border Background="{StaticResource ArtPlaceholderBrush}">
            <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="#F4F6F9"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Image x:Name="ArtImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
          <Border BorderBrush="#33000000" BorderThickness="1" />
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
          <Button Style="{StaticResource ToolButton}" Content="Choose…" Margin="0,0,6,0" Click="ChooseArt_Click" />
          <Button x:Name="RemoveArtButton" Style="{StaticResource ToolButton}" Content="Remove" Click="RemoveArt_Click" />
        </StackPanel>
        <TextBlock x:Name="ArtNote" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" Margin="2,6,10,0" />
      </StackPanel>

      <Grid Grid.Column="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="90" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
          <Style TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="#4B5563" />
          </Style>
          <Style TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,4" />
          </Style>
        </Grid.Resources>

        <TextBlock Grid.Row="0" Text="Name" />
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" />
        <TextBlock Grid.Row="1" Text="Artist" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="ArtistBox" />
        <TextBlock Grid.Row="2" Text="Album artist" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="AlbumArtistBox" />
        <TextBlock Grid.Row="3" Text="Album" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="AlbumBox" />
        <TextBlock Grid.Row="4" Text="Genre" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="GenreBox" />
        <TextBlock Grid.Row="5" Text="Year" />
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
          <TextBox x:Name="YearBox" Width="64" />
          <TextBlock Text="Track" Margin="16,0,8,0" />
          <TextBox x:Name="TrackBox" Width="48" />
          <TextBlock Text="Disc" Margin="16,0,8,0" />
          <TextBox x:Name="DiscBox" Width="48" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- Footer -->
    <DockPanel Grid.Row="2" Margin="20,6,20,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource ToolButton}" Content="Cancel" Width="80" IsCancel="True" Margin="0,0,6,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="OK" Width="80" IsDefault="True" Click="Ok_Click" />
      </StackPanel>
      <TextBlock x:Name="FooterNote" Foreground="#6B7280" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
    </DockPanel>
  </Grid>
</Window>

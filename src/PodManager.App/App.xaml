<Application x:Class="PodManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PodManager.App"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>

      <!-- ===== Palette (classic iTunes) ===== -->
      <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
      <SolidColorBrush x:Key="AccentBrush" Color="#3875D7" />
      <SolidColorBrush x:Key="TextBrush" Color="#1E1E1E" />
      <SolidColorBrush x:Key="SubtleTextBrush" Color="#6B7280" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#DDE4EC" />
      <SolidColorBrush x:Key="SidebarHeaderBrush" Color="#6E7B8B" />
      <SolidColorBrush x:Key="DividerBrush" Color="#A7ADB5" />
      <SolidColorBrush x:Key="RowAltBrush" Color="#F1F5FA" />
      <LinearGradientBrush x:Key="TopBarBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EDEDED" Offset="0" />
        <GradientStop Color="#C4C4C4" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="LcdBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FBFBF5" Offset="0" />
        <GradientStop Color="#E3E6D6" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="SelectedItemBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#6CA2E8" Offset="0" />
        <GradientStop Color="#2F6CC6" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FAFAFA" Offset="0" />
        <GradientStop Color="#E2E2E2" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="ArtPlaceholderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D9DEE5" Offset="0" />
        <GradientStop Color="#B9C1CC" Offset="1" />
      </LinearGradientBrush>

      <!-- ===== Converters ===== -->
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
      <local:BytesConverter x:Key="Bytes" />
      <local:DurationConverter x:Key="Duration" />
      <local:ZeroAsBlankConverter x:Key="ZeroBlank" />
      <local:SyncStatusBrushConverter x:Key="StatusBrush" />
      <local:SyncStatusTextConverter x:Key="StatusText" />
      <local:NodeStateBrushConverter x:Key="NodeBrush" />

      <!-- Filter chips in the Sync view -->
      <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" CornerRadius="11" BorderBrush="#B5BDC7" BorderThickness="1" Background="White" Padding="10,3">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="#5C7FAE" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#DCE7F7" />
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
      </Style>

      <!-- ===== Toolbar buttons: rounded glossy grey ===== -->
      <Style x:Key="ToolButton" TargetType="Button">
        <Setter Property="Foreground" Value="#2B2B2B" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="11" BorderBrush="#8A8A8A" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFFFFF" Offset="0" />
                    <GradientStop Color="#D6D6D6" Offset="1" />
                  </LinearGradientBrush>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="#5C7FAE" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#C2C8D0" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="11" BorderBrush="#285CB0" BorderThickness="1" Padding="{TemplateBinding Padding}"
                      Background="{StaticResource SelectedItemBrush}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#2A5FAF" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="Opacity" Value="0.45" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Text boxes with placeholder (placeholder text goes in Tag) ===== -->
      <Style x:Key="FieldBox" TargetType="TextBox">
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="b" Background="White" BorderBrush="#A9B3BF" BorderThickness="1" CornerRadius="3">
                <Grid>
                  <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                  <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="#9AA3AD" FontStyle="Italic"
                             Margin="7,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="Background" Value="#F0F0F0" />
                  <Setter Property="Foreground" Value="#888" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="b" Background="White" BorderBrush="#8E8E8E" BorderThickness="1" CornerRadius="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="#7A7A7A" FontSize="12"
                             Margin="9,0,2,0" VerticalAlignment="Center" />
                  <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" Margin="2,0,8,0" VerticalAlignment="Center" />
                  <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="#9AA3AD"
                             Margin="5,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Text" Value="">
                  <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Song grids ===== -->
      <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
        <Setter Property="Foreground" Value="#333" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="BorderBrush" Value="#C8C8C8" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
      </Style>

      <Style x:Key="GridCell" TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="DataGridCell">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="IsSelected" Value="True">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
          </Trigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="SongGrid" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Extended" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="RowHeight" Value="22" />
        <Setter Property="Background" Value="White" />
        <Setter Property="RowBackground" Value="White" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource RowAltBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource GridCell}" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      </Style>

      <!-- ===== Album tile (used in Albums and Artists views) ===== -->
      <DataTemplate x:Key="AlbumTile" DataType="{x:Type local:AlbumVm}">
        <StackPanel Width="160" Margin="10,10,10,6">
          <Grid Width="150" Height="150">
            <Border Background="{StaticResource ArtPlaceholderBrush}" CornerRadius="2">
              <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="#F4F6F9"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Image Source="{Binding Art}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
            <Border BorderBrush="#33000000" BorderThickness="1" />
            <Border Background="#CC3B4757" CornerRadius="3" Padding="4,1" Margin="4"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{Binding IsITunes, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="iTunes" Foreground="White" FontSize="10" />
            </Border>
          </Grid>
          <TextBlock Text="{Binding Album}" FontWeight="SemiBold" Margin="5,6,5,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Album}" />
          <TextBlock Text="{Binding Artist}" Foreground="{StaticResource SubtleTextBrush}" Margin="5,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DataTemplate>

      <Style x:Key="TileItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="b" CornerRadius="5" Background="Transparent" Margin="2">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#EEF2F7" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#D4E2F6" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- ===== Sidebar ===== -->
      <Style x:Key="SidebarItem" TargetType="ListBoxItem">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="b" Padding="16,4,8,4" Background="Transparent">
                <ContentPresenter />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource SelectedItemBrush}" />
                  <Setter Property="Foreground" Value="White" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#2A2F36" />
      </Style>

    </ResourceDictionary>
  </Application.Resources>
</Application>
